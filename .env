# ==========================================
# OmniSense AI - Environment Configuration
# ==========================================

ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="OmniSense AI"
API_V1_STR=/api

# Database
DATABASE_URL=sqlite:///./omnisense.db

# Security & JWT Authentication
SECRET_KEY=omnisense-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini LLM API (Set your key here; fallback keyword parser operates automatically if omitted)
GEMINI_API_KEY=

# MQTT Broker (Docker Mosquitto or Local Broker)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=omnisense_backend_gateway
MQTT_USERNAME=omnisense_user
MQTT_PASSWORD=omnisense_pass
DEVICE_OFFLINE_TIMEOUT_SECONDS=30

# Vision Pipeline & YOLO
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=15
YOLO_MODEL_NAME=yolov8n.pt

# Evidence & Artifact Storage
EVIDENCE_DIR=./evidence
STATIC_DIR=./evidence
